# Einstellungen für fuelstat-backup.sh und fuelstat-restore.sh. Als backup.env (gleicher Ordner) speichern.

# Ordner mit docker-compose.yml und .env
COMPOSE_DIR=/srv/www/tanken.1emc.de/public/infra
# Ablage der Sicherungen (am besten außerhalb des Webroots)
BACKUP_DIR=/var/backups/fuelstat
# Hochgeladene Bilder (Standard: ../uploads neben infra/)
# UPLOADS_DIR=/srv/www/tanken.1emc.de/public/uploads

# Aufbewahrung: tägliche Sicherungen und (sonntags) Wochensicherungen
KEEP_DAILY=14
KEEP_WEEKLY=12

# Verschlüsselung mit age (empfohlen, Pflicht bei Kopie nach extern). Schlüssel einmalig erzeugen:
#   age-keygen -o fuelstat-backup-key.txt    → privaten Schlüssel OFFLINE aufbewahren (Passwortmanager), nicht auf dem Server
# Hier nur den öffentlichen Schlüssel (age1…) eintragen:
# BACKUP_AGE_RECIPIENT=age1...

# Kopie nach extern per rsync, z. B. Hetzner Storage Box (SSH-Port 23, Zugang per SSH-Schlüssel):
# BACKUP_REMOTE=u123456@u123456.your-storagebox.de:fuelstat/
# BACKUP_REMOTE_SSH="ssh -p 23 -i /root/.ssh/storagebox"
