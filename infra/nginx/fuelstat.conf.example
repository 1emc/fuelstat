# Vollständige nginx-Konfiguration für Fuelstat (Beispiel). Platzhalter anpassen:
#   fuelstat.example.de          → eigene Domain
#   /srv/www/fuelstat/public     → Webroot (= Repository-Wurzel)
#   /run/php/php8.4-fpm.sock     → Socket des PHP-FPM-Pools
# Voraussetzungen: infra/nginx-sicherheit.conf.example als /etc/nginx/snippets/fuelstat-sicherheit.conf,
# Zertifikat von Let's Encrypt, vor dem Aktivieren dieser Datei holen: sudo certbot certonly --nginx -d fuelstat.example.de
# Prüfen und laden: sudo nginx -t && sudo systemctl reload nginx

# Cache-Dauer für CSS/JS: mit ?v=… (Version) ein Jahr, sonst bei jedem Aufruf prüfen (#89)
map $arg_v $asset_cache {
    ""      "no-cache";
    default "public, max-age=31536000, immutable";
}

# HTTP → HTTPS (Let's Encrypt muss per HTTP erreichbar bleiben)
server {
    listen 80;
    listen [::]:80;
    server_name fuelstat.example.de;
    root /srv/www/fuelstat/public;

    location ^~ /.well-known/acme-challenge/ { allow all; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name fuelstat.example.de;
    root /srv/www/fuelstat/public;
    index index.php index.html;

    ssl_certificate     /etc/letsencrypt/live/fuelstat.example.de/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/fuelstat.example.de/privkey.pem;

    # Uploads (Fahrzeug- und Profilbilder bis 20 MB, große CSV-Importe)
    client_max_body_size 20m;

    # Sicherheits-Header (gelten für alle Antworten ohne eigenes add_header)
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(self)" always;

    # Sperren zuerst: Regex-Regeln werden in Reihenfolge geprüft
    include snippets/fuelstat-sicherheit.conf;

    # --- Anwendung -----------------------------------------------------------
    location / {
        try_files $uri $uri/ /index.php?$args;
    }

    # Node-API im Docker-Container (Port nur auf 127.0.0.1); ^~ damit keine Datei-Regel die API-Pfade abfängt
    location ^~ /api/v1/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Diese Header setzt die API selbst (helmet) – nicht doppelt ausliefern
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header X-Frame-Options;
        proxy_hide_header Strict-Transport-Security;
        proxy_hide_header Referrer-Policy;
    }

    # PHP-Frontend. Die API direkt ansprechen, nicht über die öffentliche Adresse (sonst geht jeder
    # API-Aufruf über Cloudflare bzw. das Internet und kostet je ca. 0,2 s, siehe #89)
    location ~ \.php$ {
        try_files $uri =404;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param HTTPS on;
        fastcgi_param FUELSTAT_API_BASE_URL http://127.0.0.1:3000/api/v1;
        fastcgi_pass unix:/run/php/php8.4-fpm.sock;
    }

    # Service Worker nie lange cachen, sonst kommen Updates der App nicht an
    location = /service-worker.js {
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    # CSS/JS: Die Seiten binden sie mit ?v=<Änderungszeit> ein (assetUrl). Mit Version ein Jahr unverändert
    # behalten (kein Nachfragen bei jedem Seitenwechsel), ohne Version kurz prüfen ($asset_cache, siehe oben)
    location ~* \.(?:css|js)$ {
        add_header Cache-Control $asset_cache;
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    # Bilder und Schriften: 30 Tage
    location ~* \.(?:jpe?g|gif|png|svg|webp|ico|woff2?)$ {
        expires 30d;
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }
}
