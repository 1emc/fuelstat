# Sicherheitsregeln für den Fuelstat-Webroot (nginx). Als /etc/nginx/snippets/fuelstat-sicherheit.conf ablegen
# und im server { … }-Block der Seite GANZ OBEN einbinden (include snippets/fuelstat-sicherheit.conf;),
# also vor den Regeln für *.php und statische Dateien. Vollständiges Beispiel: infra/nginx/fuelstat.conf.example
# Hintergrund: Das Repository ist der Webroot. Ohne diese Regeln wären .env-Dateien, .git, API-Schlüssel,
# Backend-Code, Konfiguration und Dokumentation direkt abrufbar.

# security.txt (RFC 9116) als Text mit UTF-8 ausliefern; /.well-known/ ist von der Sperre unten ausgenommen
location = /.well-known/security.txt {
    default_type text/plain;
    charset utf-8;
}

# Interne Verzeichnisse (Präfix mit ^~ greift vor allen Regex-Regeln, auch vor *.php)
location ^~ /backend/  { return 404; }
location ^~ /infra/    { return 404; }
location ^~ /database/ { return 404; }
location ^~ /tests/    { return 404; }
location ^~ /docs/     { return 404; }
location ^~ /vendor/node_modules/ { return 404; }

# Versteckte Dateien und Verzeichnisse (.git, .env, .github, .htaccess …)
location ~ /\.(?!well-known/) { return 404; }

# API-Schlüssel (api/key.key für Tankerkönig, api/ocm.key für Open Charge Map und künftige *.key-Dateien)
location ~* \.key$ { return 404; }

# Doku-, Konfigurations- und Skriptdateien aus dem Repository (readme.md, SECURITY.md, *.yml, Backups, Logs …)
location ~* \.(?:md|ya?ml|example|sql|sh|lock|bak|log|dist|service|timer|env)$ { return 404; }
location ~* /(?:package(?:-lock)?|composer)\.json$ { return 404; }

# includes/ enthält nur eingebundene Dateien – bis auf das Sortier-Formular
location ~ ^/includes/(?!fahrzeug_sortieren\.php$) { return 404; }

# Hochgeladene Bilder: nie als PHP ausführen, nur Bildformate ausliefern
location ^~ /uploads/ {
    location ~* \.(?:jpe?g|png|gif|webp)$ {
        expires 30d;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Content-Security-Policy "default-src 'none'; img-src 'self'; sandbox" always;
        try_files $uri =404;
    }
    return 404;
}
